# Contact Form Configuration
# Add these to .env.local to enable direct server-side email dispatch

# Resend API Key (Recommended - https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Verified Sender Email Address (e.g. your verified domain or onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Recipient Email Address where inquiries will be delivered
CONTACT_TO_EMAIL=pratyush.me.ai@gmail.com

# Alternatively, a generic webhook URL (Slack, Discord, Formspree):
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/...
